@@ -0,0 +1,161 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  compareVersions,
+  findOrphanedDependencies,
+  parseDependency,
+  resolveInstallPlan,
+} from "./dependencies";
+import { LOADERS, isSafeRelativePath, toSupportedLoader } from "./loaders";
+import type { ThunderstorePackage } from "../../../types/mods.types";
+
+const pkg = (
+  fullName: string,
+  versions: [string, string[]][]
+): ThunderstorePackage => ({
+  fullName,
+  owner: fullName.split("-")[0],
+  name: fullName.split("-").slice(1).join("-"),
+  description: "",
+  icon: "",
+  rating: 0,
+  downloads: 0,
+  categories: [],
+  isDeprecated: false,
+  isNsfw: false,
+  dateUpdated: "",
+  packageUrl: "",
+  versions: versions.map(([version, dependencies]) => ({
+    version,
+    dependencies,
+    downloadUrl: `https://x/${fullName}/${version}`,
+    fileSize: 1,
+  })),
+});
+
+const index = new Map(
+  [
+    pkg("bbepis-BepInExPack", [
+      ["5.4.2100", []],
+      ["5.4.2000", []],
+    ]),
+    pkg("A-ModA", [
+      ["1.0.0", ["bbepis-BepInExPack-5.4.2000", "B-Lib_B-1.0.0"]],
+    ]),
+    pkg("B-Lib_B", [["1.2.0", ["bbepis-BepInExPack-5.4.2000"]]]),
+    pkg("C-Cyc", [["1.0.0", ["D-Cyc2-1.0.0"]]]),
+    pkg("D-Cyc2", [["1.0.0", ["C-Cyc-1.0.0"]]]),
+    pkg("E-Broken", [["1.0.0", ["Nope-Missing-1.0.0"]]]),
+  ].map((p) => [p.fullName, p])
+);
+
+test("parseDependency handles underscores and dashes in names", () => {
+  assert.deepEqual(parseDependency("B-Lib_B-1.0.0"), {
+    owner: "B",
+    name: "Lib_B",
+    version: "1.0.0",
+    fullName: "B-Lib_B",
+  });
+  assert.equal(parseDependency("garbage"), null);
+});
+
+test("compareVersions", () => {
+  assert.equal(compareVersions("1.10.0", "1.9.9"), 1);
+  assert.equal(compareVersions("1.0", "1.0.0"), 0);
+  assert.equal(compareVersions("0.9.9", "1.0.0"), -1);
+});
+
+test("plan installs dependencies first, loader once, newest version", () => {
+  const { plan, missing } = resolveInstallPlan("A-ModA", index, {});
+  assert.deepEqual(
+    plan.map((p) => p.fullName),
+    ["bbepis-BepInExPack", "B-Lib_B", "A-ModA"]
+  );
+  assert.equal(plan[0].version, "5.4.2100");
+  assert.equal(plan[2].isDependency, false);
+  assert.deepEqual(missing, []);
+});
+
+test("installed deps that satisfy the minimum are skipped", () => {
+  const { plan } = resolveInstallPlan("A-ModA", index, {
+    "bbepis-BepInExPack": { version: "5.4.2000" },
+  });
+  assert.deepEqual(
+    plan.map((p) => p.fullName),
+    ["B-Lib_B", "A-ModA"]
+  );
+});
+
+test("cycles terminate and missing deps are reported", () => {
+  assert.equal(resolveInstallPlan("C-Cyc", index, {}).plan.length, 2);
+  assert.deepEqual(resolveInstallPlan("E-Broken", index, {}).missing, [
+    "Nope-Missing",
+  ]);
+});
+
+test("orphan detection keeps deps of explicitly installed mods", () => {
+  const installed = {
+    "A-ModA": { isDependency: false },
+    "B-Lib_B": { isDependency: true },
+    "bbepis-BepInExPack": { isDependency: true },
+    "C-Cyc": { isDependency: true },
+  };
+  const versions = {
+    "A-ModA": "1.0.0",
+    "B-Lib_B": "1.2.0",
+    "bbepis-BepInExPack": "5.4.2100",
+    "C-Cyc": "1.0.0",
+  };
+  assert.deepEqual(findOrphanedDependencies(installed, index, versions), [
+    "C-Cyc",
+  ]);
+});
+
+test("bepinex loader strips wrapper folder, skips meta files", () => {
+  const moves = LOADERS.bepinex.planLoader([
+    "manifest.json",
+    "icon.png",
+    "BepInExPack/winhttp.dll",
+    "BepInExPack/BepInEx/core/BepInEx.dll",
+  ]);
+  assert.deepEqual(
+    moves.map((m) => m.to),
+    ["winhttp.dll", "BepInEx/core/BepInEx.dll"]
+  );
+});
+
+test("bepinex mod layouts", () => {
+  const m = (files: string[]) =>
+    LOADERS.bepinex.planMod(files, "A-ModA").map((x) => x.to);
+  assert.deepEqual(m(["manifest.json", "Mod.dll"]), [
+    "BepInEx/plugins/A-ModA/Mod.dll",
+  ]);
+  assert.deepEqual(m(["plugins/Mod.dll", "config/a.cfg"]), [
+    "BepInEx/plugins/A-ModA/Mod.dll",
+    "BepInEx/config/a.cfg",
+  ]);
+  assert.deepEqual(m(["BepInEx/plugins/Mod.dll"]), ["BepInEx/plugins/Mod.dll"]);
+  assert.deepEqual(m(["Stuff/data.json"]), [
+    "BepInEx/plugins/A-ModA/Stuff/data.json",
+  ]);
+});
+
+test("melonloader mod layouts", () => {
+  const m = (files: string[]) =>
+    LOADERS.melonloader.planMod(files, "A-ModA").map((x) => x.to);
+  assert.deepEqual(m(["Mods/x.dll", "UserLibs/y.dll", "z.dll"]), [
+    "Mods/x.dll",
+    "UserLibs/y.dll",
+    "Mods/z.dll",
+  ]);
+});
+
+test("path safety and loader mapping", () => {
+  assert.equal(isSafeRelativePath("BepInEx/plugins/a.dll"), true);
+  assert.equal(isSafeRelativePath("../evil.dll"), false);
+  assert.equal(isSafeRelativePath("a/../../evil"), false);
+  assert.equal(isSafeRelativePath("C:/evil"), false);
+  assert.equal(toSupportedLoader("bepinex"), "bepinex");
+  assert.equal(toSupportedLoader("gdweave"), null);
+  assert.equal(toSupportedLoader(undefined), "bepinex");
+});
diff --git a/src/main/services/mods/package-index.ts b/src/main/services/mods/package-index.ts
new file mode 100644
index 0000000..551f09a
--- /dev/null
+++ b/src/main/services/mods/package-index.ts
@@ -0,0 +1,198 @@
+import fs from "node:fs";
+import path from "node:path";
+import axios from "axios";
+import { logger } from "../logger";
+import { modsCachePath } from "./paths";
+import type {
+  ModSearchOptions,
+  ModSearchResult,
+  ThunderstorePackage,
+} from "../../../types/mods.types";
+
+const REFRESH_AFTER_MS = 60 * 60 * 1000;
+const UA = { "User-Agent": "HydraLauncher-ModManager" };
+
+interface CacheEntry {
+  community: string;
+  fetchedAt: number;
+  etag: string | null;
+  lastModified: string | null;
+  packages: ThunderstorePackage[];
+}
+
+const memory = new Map<
+  string,
+  CacheEntry & { map: Map<string, ThunderstorePackage> }
+>();
+const inflight = new Map<string, Promise<void>>();
+
+const fileFor = (community: string) =>
+  path.join(modsCachePath, `${community.replace(/[^a-z0-9_-]/gi, "_")}.json`);
+
+const slim = (raw: any[]): ThunderstorePackage[] =>
+  raw
+    .filter((p) => Array.isArray(p?.versions) && p.versions.length > 0)
+    .map((p) => {
+      const latest = p.versions[0];
+      return {
+        fullName: p.full_name,
+        owner: p.owner,
+        name: p.name,
+        description: latest.description ?? "",
+        icon: latest.icon ?? "",
+        rating: p.rating_score ?? 0,
+        downloads: p.versions.reduce(
+          (sum: number, v: any) => sum + (v.downloads ?? 0),
+          0
+        ),
+        categories: p.categories ?? [],
+        isDeprecated: !!p.is_deprecated,
+        isNsfw: !!p.has_nsfw_content,
+        dateUpdated: p.date_updated ?? latest.date_created ?? "",
+        packageUrl: p.package_url ?? "",
+        versions: p.versions.map((v: any) => ({
+          version: v.version_number,
+          dependencies: v.dependencies ?? [],
+          downloadUrl: v.download_url,
+          fileSize: v.file_size ?? 0,
+        })),
+      } satisfies ThunderstorePackage;
+    });
+
+const hydrate = (entry: CacheEntry) => {
+  const map = new Map(entry.packages.map((p) => [p.fullName, p]));
+  const full = { ...entry, map };
+  memory.set(entry.community, full);
+  return full;
+};
+
+const loadFromDisk = async (community: string) => {
+  try {
+    const entry: CacheEntry = JSON.parse(
+      await fs.promises.readFile(fileFor(community), "utf8")
+    );
+    return hydrate(entry);
+  } catch {
+    return null;
+  }
+};
+
+const refresh = async (community: string) => {
+  const existing = memory.get(community);
+  const headers: Record<string, string> = { ...UA };
+  if (existing?.etag) headers["If-None-Match"] = existing.etag;
+  if (existing?.lastModified)
+    headers["If-Modified-Since"] = existing.lastModified;
+
+  const response = await axios.get(
+    `https://thunderstore.io/c/${encodeURIComponent(community)}/api/v1/package/`,
+    {
+      headers,
+      timeout: 120_000,
+      maxContentLength: Infinity,
+      maxBodyLength: Infinity,
+      validateStatus: (s) => (s >= 200 && s < 300) || s === 304,
+    }
+  );
+
+  if (response.status === 304 && existing) {
+    existing.fetchedAt = Date.now();
+    await persist(existing);
+    return;
+  }
+
+  const entry: CacheEntry = {
+    community,
+    fetchedAt: Date.now(),
+    etag: response.headers["etag"] ?? null,
+    lastModified: response.headers["last-modified"] ?? null,
+    packages: slim(Array.isArray(response.data) ? response.data : []),
+  };
+  hydrate(entry);
+  await persist(entry);
+};
+
+const persist = async (entry: CacheEntry) => {
+  const { packages, ...rest } = entry;
+  await fs.promises.mkdir(modsCachePath, { recursive: true });
+  await fs.promises.writeFile(
+    fileFor(entry.community),
+    JSON.stringify({ ...rest, packages })
+  );
+};
+
+/** Returns the cached index, refreshing it in the background-safe way. */
+export const getPackageIndex = async (community: string, force = false) => {
+  let entry = memory.get(community) ?? (await loadFromDisk(community));
+  const stale = !entry || Date.now() - entry.fetchedAt > REFRESH_AFTER_MS;
+
+  if (force || stale) {
+    let job = inflight.get(community);
+    if (!job) {
+      job = refresh(community).finally(() => inflight.delete(community));
+      inflight.set(community, job);
+    }
+    try {
+      await job;
+    } catch (error) {
+      logger.error(
+        `Failed to refresh Thunderstore index (${community})`,
+        error
+      );
+      if (!entry) throw error; // no cache to fall back to
+    }
+    entry = memory.get(community) ?? entry;
+  }
+
+  return entry!;
+};
+
+export const searchPackages = async (
+  community: string,
+  options: ModSearchOptions = {}
+): Promise<ModSearchResult> => {
+  const {
+    query = "",
+    sort = "downloads",
+    page = 0,
+    pageSize = 30,
+    category,
+    includeDeprecated = false,
+    includeNsfw = false,
+  } = options;
+
+  const { packages } = await getPackageIndex(community);
+  const q = query.trim().toLowerCase();
+
+  const categories = new Set<string>();
+  for (const p of packages) p.categories.forEach((c) => categories.add(c));
+
+  let items = packages.filter((p) => {
+    if (!includeDeprecated && p.isDeprecated) return false;
+    if (!includeNsfw && p.isNsfw) return false;
+    if (category && !p.categories.includes(category)) return false;
+    if (!q) return true;
+    return (
+      p.name.toLowerCase().includes(q) ||
+      p.owner.toLowerCase().includes(q) ||
+      p.description.toLowerCase().includes(q)
+    );
+  });
+
+  const sorters: Record<
+    string,
+    (a: ThunderstorePackage, b: ThunderstorePackage) => number
+  > = {
+    downloads: (a, b) => b.downloads - a.downloads,
+    rating: (a, b) => b.rating - a.rating,
+    updated: (a, b) => b.dateUpdated.localeCompare(a.dateUpdated),
+    name: (a, b) => a.name.localeCompare(b.name),
+  };
+  items = [...items].sort(sorters[sort] ?? sorters.downloads);
+
+  return {
+    total: items.length,
+    items: items.slice(page * pageSize, (page + 1) * pageSize),
+    categories: [...categories].sort(),
+  };
+};
