+import { shell } from "electron";
+import path from "node:path";
+import { registerEvent } from "../register-event";
+import {
+  getEcosystem,
+  getGameStatus,
+  getPackageIndex,
+  installMod,
+  searchPackages,
+  setGameCommunity,
+  setModEnabled,
+  uninstallMod,
+} from "@main/services/mods";
+import { modsRoot } from "@main/services/mods/paths";
+import type { GameShop } from "@types";
+import type { ModLoaderId, ModSearchOptions } from "@types";
+
+registerEvent("modsGetStatus", (_e, shop: GameShop, objectId: string) =>
+  getGameStatus(shop, objectId)
+);
+
+registerEvent("modsListCommunities", async () => {
+  const games = await getEcosystem();
+  return games.map(({ identifier, name, packageLoader }) => ({
+    identifier,
+    name,
+    packageLoader,
+  }));
+});
+
+registerEvent(
+  "modsSetCommunity",
+  (
+    _e,
+    shop: GameShop,
+    objectId: string,
+    community: string,
+    loader?: ModLoaderId
+  ) => setGameCommunity(shop, objectId, community, loader)
+);
+
+registerEvent(
+  "modsSearch",
+  (_e, community: string, options: ModSearchOptions) =>
+    searchPackages(community, options)
+);
+
+registerEvent("modsRefreshIndex", async (_e, community: string) => {
+  await getPackageIndex(community, true);
+});
+
+registerEvent(
+  "modsInstall",
+  (_e, shop: GameShop, objectId: string, fullName: string, version?: string) =>
+    installMod(shop, objectId, fullName, version)
+);
+
+registerEvent(
+  "modsUninstall",
+  (
+    _e,
+    shop: GameShop,
+    objectId: string,
+    fullName: string,
+    removeOrphans?: boolean
+  ) => uninstallMod(shop, objectId, fullName, removeOrphans)
+);
+
+registerEvent(
+  "modsSetEnabled",
+  (_e, shop: GameShop, objectId: string, fullName: string, enabled: boolean) =>
+    setModEnabled(shop, objectId, fullName, enabled)
+);
+
+registerEvent(
+  "modsOpenFolder",
+  async (_e, shop: GameShop, objectId: string) => {
+    const status = await getGameStatus(shop, objectId);
+    await shell.openPath(status.gameDir ?? path.join(modsRoot));
+  }
+);
diff --git a/src/main/services/mods/dependencies.ts b/src/main/services/mods/dependencies.ts
new file mode 100644
index 0000000..1d5e2e5
--- /dev/null
+++ b/src/main/services/mods/dependencies.ts
@@ -0,0 +1,137 @@
+import type { ThunderstorePackage } from "../../../types/mods.types";
+
+export interface ParsedDependency {
+  owner: string;
+  name: string;
+  version: string;
+  fullName: string;
+}
+
+/** "Owner-Name-1.2.3" -> parts. Owner has no dashes; version has none either. */
+export const parseDependency = (dep: string): ParsedDependency | null => {
+  const first = dep.indexOf("-");
+  const last = dep.lastIndexOf("-");
+  if (first <= 0 || last <= first) return null;
+  const owner = dep.slice(0, first);
+  const name = dep.slice(first + 1, last);
+  const version = dep.slice(last + 1);
+  if (!owner || !name || !/^\d+(\.\d+)*/.test(version)) return null;
+  return { owner, name, version, fullName: `${owner}-${name}` };
+};
+
+export const compareVersions = (a: string, b: string): number => {
+  const pa = a.split(/[.-]/).map((n) => parseInt(n, 10) || 0);
+  const pb = b.split(/[.-]/).map((n) => parseInt(n, 10) || 0);
+  const len = Math.max(pa.length, pb.length);
+  for (let i = 0; i < len; i++) {
+    const diff = (pa[i] ?? 0) - (pb[i] ?? 0);
+    if (diff !== 0) return diff > 0 ? 1 : -1;
+  }
+  return 0;
+};
+
+export interface PlannedInstall {
+  fullName: string;
+  version: string;
+  downloadUrl: string;
+  isDependency: boolean;
+}
+
+export interface ResolveResult {
+  /** Dependencies first, requested package last. */
+  plan: PlannedInstall[];
+  missing: string[];
+}
+
+/**
+ * Resolves what must be installed for `rootFullName`.
+ * - A dependency already installed at >= the required version is kept.
+ * - Otherwise the newest indexed version is used (always >= the required one).
+ * - Cycle-safe; unknown packages are reported in `missing`.
+ */
+export const resolveInstallPlan = (
+  rootFullName: string,
+  index: Map<string, ThunderstorePackage>,
+  installed: Record<string, { version: string }>,
+  rootVersion?: string
+): ResolveResult => {
+  const plan: PlannedInstall[] = [];
+  const missing: string[] = [];
+  const visiting = new Set<string>();
+  const done = new Set<string>();
+
+  const visit = (
+    fullName: string,
+    minVersion: string | undefined,
+    isDependency: boolean
+  ) => {
+    if (done.has(fullName) || visiting.has(fullName)) return;
+
+    const pkg = index.get(fullName);
+    if (!pkg || pkg.versions.length === 0) {
+      if (!missing.includes(fullName)) missing.push(fullName);
+      return;
+    }
+
+    const current = installed[fullName]?.version;
+    const alreadyOk =
+      isDependency &&
+      current !== undefined &&
+      (!minVersion || compareVersions(current, minVersion) >= 0);
+    if (alreadyOk) {
+      done.add(fullName);
+      return;
+    }
+
+    const target =
+      (!isDependency && rootVersion
+        ? pkg.versions.find((v) => v.version === rootVersion)
+        : undefined) ?? pkg.versions[0];
+
+    visiting.add(fullName);
+    for (const raw of target.dependencies) {
+      const dep = parseDependency(raw);
+      if (!dep) continue;
+      visit(dep.fullName, dep.version, true);
+    }
+    visiting.delete(fullName);
+
+    done.add(fullName);
+    plan.push({
+      fullName,
+      version: target.version,
+      downloadUrl: target.downloadUrl,
+      isDependency,
+    });
+  };
+
+  visit(rootFullName, undefined, false);
+  return { plan, missing };
+};
+
+/** Installed mods that nothing else installed depends on (for safe cleanup). */
+export const findOrphanedDependencies = (
+  installed: Record<string, { isDependency: boolean }>,
+  index: Map<string, ThunderstorePackage>,
+  installedVersions: Record<string, string>
+): string[] => {
+  const needed = new Set<string>();
+  for (const [fullName, mod] of Object.entries(installed)) {
+    if (mod.isDependency) continue;
+    const stack = [fullName];
+    while (stack.length) {
+      const cur = stack.pop()!;
+      if (needed.has(cur)) continue;
+      needed.add(cur);
+      const pkg = index.get(cur);
+      const version =
+        pkg?.versions.find((v) => v.version === installedVersions[cur]) ??
+        pkg?.versions[0];
+      for (const raw of version?.dependencies ?? []) {
+        const dep = parseDependency(raw);
+        if (dep && installed[dep.fullName]) stack.push(dep.fullName);
+      }
+    }
+  }
+  return Object.keys(installed).filter((n) => !needed.has(n));
+};
diff --git a/src/main/services/mods/ecosystem.ts b/src/main/services/mods/ecosystem.ts
new file mode 100644
index 0000000..96b764b
--- /dev/null
+++ b/src/main/services/mods/ecosystem.ts
@@ -0,0 +1,130 @@
+import fs from "node:fs";
+import path from "node:path";
+import axios from "axios";
+import { logger } from "../logger";
+import { modsCachePath } from "./paths";
+import type { ThunderstoreCommunity } from "../../../types/mods.types";
+
+const ECOSYSTEM_URL =
+  "https://thunderstore.io/api/experimental/schema/dev/latest/";
+const COMMUNITY_LIST_URL =
+  "https://thunderstore.io/api/experimental/community/";
+const TTL_MS = 24 * 60 * 60 * 1000;
+const UA = { "User-Agent": "HydraLauncher-ModManager" };
+
+export interface EcosystemGame extends ThunderstoreCommunity {
+  steamIds: string[];
+  packageLoader: string | null;
+}
+
+let memory: { at: number; games: EcosystemGame[] } | null = null;
+const cacheFile = path.join(modsCachePath, "ecosystem.json");
+
+/**
+ * The ecosystem schema is "experimental" on Thunderstore's side, so every
+ * field is read defensively and unknown shapes are skipped, not thrown on.
+ */
+export const parseEcosystem = (raw: any): EcosystemGame[] => {
+  const games = raw?.games;
+  if (!games || typeof games !== "object") return [];
+
+  return Object.entries<any>(games).map(([identifier, game]) => {
+    const distributions: any[] = Array.isArray(game?.distributions)
+      ? game.distributions
+      : [];
+    const steamIds = distributions
+      .filter(
+        (d) =>
+          typeof d?.platform === "string" &&
+          d.platform.toLowerCase().startsWith("steam") &&
+          d.identifier
+      )
+      .map((d) => String(d.identifier));
+
+    const r2 = Array.isArray(game?.r2modman) ? game.r2modman[0] : undefined;
+
+    return {
+      identifier,
+      name: game?.meta?.displayName ?? game?.label ?? identifier,
+      steamIds,
+      packageLoader: r2?.packageLoader ?? null,
+    };
+  });
+};
+
+const readDisk = async (): Promise<typeof memory> => {
+  try {
+    const stat = await fs.promises.stat(cacheFile);
+    const games = JSON.parse(await fs.promises.readFile(cacheFile, "utf8"));
+    return { at: stat.mtimeMs, games };
+  } catch {
+    return null;
+  }
+};
+
+const fallbackFromCommunityList = async (): Promise<EcosystemGame[]> => {
+  const out: EcosystemGame[] = [];
+  let url: string | null = COMMUNITY_LIST_URL;
+  while (url && out.length < 2000) {
+    const { data } = await axios.get(url, { headers: UA, timeout: 20_000 });
+    for (const c of data?.results ?? []) {
+      out.push({
+        identifier: c.identifier,
+        name: c.name ?? c.identifier,
+        steamIds: [],
+        packageLoader: null,
+      });
+    }
+    url = data?.pagination?.next_link ?? null;
+  }
+  return out;
+};
+
+export const getEcosystem = async (force = false): Promise<EcosystemGame[]> => {
+  if (!force && memory && Date.now() - memory.at < TTL_MS) return memory.games;
+
+  if (!force) {
+    const disk = await readDisk();
+    if (disk && Date.now() - disk.at < TTL_MS) {
+      memory = disk;
+      return disk.games;
+    }
+  }
+
+  try {
+    const { data } = await axios.get(ECOSYSTEM_URL, {
+      headers: UA,
+      timeout: 30_000,
+    });
+    let games = parseEcosystem(data);
+    if (games.length === 0) games = await fallbackFromCommunityList();
+
+    memory = { at: Date.now(), games };
+    await fs.promises.mkdir(modsCachePath, { recursive: true });
+    await fs.promises.writeFile(cacheFile, JSON.stringify(games));
+    return games;
+  } catch (error) {
+    logger.error("Failed to fetch Thunderstore ecosystem", error);
+    const stale = memory ?? (await readDisk());
+    if (stale) return stale.games;
+    throw error;
+  }
+};
+
+export const findGameBySteamId = async (
+  steamId: string
+): Promise<EcosystemGame | null> => {
+  const games = await getEcosystem();
+  return games.find((g) => g.steamIds.includes(String(steamId))) ?? null;
+};
+
+/** Fuzzy fallback for non-Steam games: exact normalised-title match only. */
+export const findGameByTitle = async (
+  title: string
+): Promise<EcosystemGame | null> => {
+  const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, "");
+  const wanted = norm(title);
+  if (!wanted) return null;
+  const games = await getEcosystem();
+  return games.find((g) => norm(g.name) === wanted) ?? null;
+};
